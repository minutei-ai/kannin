{
  "name": "kannin",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "files": [
    "src/sdk.ts",
    "src/rpc.ts",
    "src/protocol.ts",
    "README.md",
    "LICENSE",
    "docs/sdk.md"
  ],
  "type": "module",
  "exports": {
    ".": "./src/sdk.ts",
    "./protocol": "./src/protocol.ts",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "build": "bun tooling/build.ts",
    "test": "bun run build && bun run test:built",
    "test:built": "cargo test --workspace --locked && bun tooling/test.ts",
    "check": "bun run format:check && bun run build && bun run lint:ts && bun run lint:rust && bun run typecheck && bun run test:built",
    "format": "oxfmt . && cargo fmt --all",
    "format:check": "oxfmt --check . && cargo fmt --all -- --check",
    "dev": "bun run build && alchemy dev alchemy.run.ts --stage dev --profile minutei",
    "plan": "bun run build && alchemy plan alchemy.run.ts --profile minutei",
    "deploy": "bun run build && alchemy deploy alchemy.run.ts --profile minutei",
    "bench": "bun tooling/benchmark.ts",
    "prepare": "effect-tsgo patch --oxlint",
    "lint:ts": "oxlint --deny-warnings --report-unused-disable-directives .",
    "lint:rust": "cargo clippy --workspace --all-targets --all-features --locked -- -D warnings && cargo clippy --workspace --lib --target wasm32-unknown-unknown --release --locked -- -D warnings",
    "quality": "bun run build && bun tooling/quality.ts",
    "typecheck": "tsc --singleThreaded --noEmit",
    "start": "bun dist/server/main.js"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/docker": "2.0.0-beta.84",
    "@alchemy.run/railway": "2.0.0-beta.84",
    "@aws-sdk/client-s3": "^3.1158.0",
    "@cloudflare/workers-types": "5.20261027.1",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/tsgo": "0.62.0",
    "@oxlint/plugins": "1.90.0",
    "@qdrant/js-client-rest": "^1.20.0",
    "@turbopuffer/turbopuffer": "2.12.0",
    "@types/bun": "1.4.4",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6",
    "miniflare": "5.20261023.1-beta",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "effect": "^4.0.0"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "@alchemy.run/cloudflare@2.0.0-beta.84": "patches/@alchemy.run%2Fcloudflare@2.0.0-beta.84.patch"
  }
}
