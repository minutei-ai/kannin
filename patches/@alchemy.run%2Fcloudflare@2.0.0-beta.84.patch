+import { Queue } from "@alchemy.run/cloudflare-runtime/core/bindings";
+import { open } from "@alchemy.run/cloudflare-runtime/core/platform-proxy";
+import type * as runtime from "@cloudflare/workers-types";
+import type * as Context from "effect/Context";
+import * as Effect from "effect/Effect";
+import { gatewayName, localGatewayRuntime } from "../LocalGateway.ts";
+import type { makeQueueHelpers } from "./QueueBinding.ts";
+import { SendError } from "./QueueTypes.ts";
+
+const tryPromise = <T>(fn: () => Promise<T>): Effect.Effect<T, SendError> =>
+  Effect.tryPromise({
+    try: fn,
+    catch: (cause) => new SendError({ message: "Local queue operation failed", cause }),
+  });
+
+export const makeProxyQueueHelpers = (
+  queueName: string,
+  ambient: Context.Context<never>,
+): ReturnType<typeof makeQueueHelpers> => {
+  const use = <T>(fn: (queue: runtime.Queue<unknown>) => Promise<T>): Effect.Effect<T, SendError> => {
+    const bindings = [Queue.local({ binding: "QUEUE", queueName })];
+    return Effect.scoped(
+      Effect.gen(function* () {
+        const proxy = yield* open<typeof bindings, { QUEUE: runtime.Queue<unknown> }>({
+          name: gatewayName("alchemy-queue-gateway", queueName),
+          bindings,
+        });
+        return yield* tryPromise(() => fn(proxy.env.QUEUE));
+      }),
+    ).pipe(
+      Effect.provide(localGatewayRuntime),
+      Effect.provideContext(ambient),
+      Effect.mapError((cause) => new SendError({ message: "Local queue gateway failed", cause })),
+    ) as Effect.Effect<T, SendError>;
+  };
+
+  const raw = Effect.die(
+    new SendError({
+      message: "A local queue binding is scoped to its gateway; use send or sendBatch.",
+    }),
+  );
+
+  return { raw, use, tryPromise };
+};
